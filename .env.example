# Shared HMAC secret for the gateway cookie. Required.
DSH_GW_SECRET=replace-with-a-long-random-string

# Host port for OpenResty. Worker 3080 ports stay unpublished.
GW_PORT=80

# 1 when the gateway is served over HTTPS.
COOKIE_SECURE=0
COOKIE_TTL_SECONDS=43200

# Absolute or compose-relative path to the deepseek-harness checkout.
HARNESS_PATH=../deepseek-harness

# Optional model keys passed into every worker container.
DEEPSEEK_API_KEY=
MINIMAX_CN_API_KEY=
